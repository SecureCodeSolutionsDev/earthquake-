{
  "rules": {
    "wasla_dating": {
      "admins": {
        ".read": false,
        ".write": false
      },
      "users": {
        ".read": "auth != null && !root.child('wasla_dating/banned/'+auth.uid).exists()",
        "$uid": {
          ".write": "(auth != null && auth.uid === $uid) || root.child('wasla_dating/admins/'+auth.uid).exists()"
        }
      },
      "photos": {
        ".read": "auth != null && !root.child('wasla_dating/banned/'+auth.uid).exists()",
        "$uid": {
          ".write": "(auth != null && auth.uid === $uid) || root.child('wasla_dating/admins/'+auth.uid).exists()",
          "$slot": {
            ".validate": "newData.isString() && newData.val().length < 400000"
          }
        }
      },
      "fcmTokens": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$tid": {
            ".validate": "newData.isString() && newData.val().length < 400"
          }
        }
      },
      "presence": {
        ".read": "auth != null",
        "$uid": { ".write": "auth != null && auth.uid === $uid" }
      },
      "swipes": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "incoming": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$from": { ".write": "auth != null && auth.uid === $from" }
        }
      },
      "giftsFor": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$giftId": { ".write": "auth != null && auth.uid != $uid" }
        }
      },
      "userMatches": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "matches": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$mid": {
          ".read": "auth != null && $mid.contains(auth.uid)",
          ".write": "auth != null && $mid.contains(auth.uid)"
        }
      },
      "chatMeta": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$mid": {
          ".read": "auth != null && $mid.contains(auth.uid)",
          ".write": "auth != null && $mid.contains(auth.uid)"
        }
      },
      "chats": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$mid": {
          ".read": "auth != null && $mid.contains(auth.uid)",
          ".write": "auth != null && $mid.contains(auth.uid)"
        }
      },
      "typing": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$mid": {
          ".read": "auth != null && $mid.contains(auth.uid)",
          ".write": "auth != null && $mid.contains(auth.uid)"
        }
      },
      "orders": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$oid": {
            ".write": "(auth != null && auth.uid === $uid) || root.child('wasla_dating/admins/'+auth.uid).exists()"
          }
        }
      },
      "reports": {
        ".read": "root.child('wasla_dating/admins/'+auth.uid).exists()",
        "$rid": { ".write": "auth != null" }
      },
      "banned": {
        ".read": "auth != null",
        ".write": "root.child('wasla_dating/admins/'+auth.uid).exists()"
      }
    }
  }
}
